<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpTurns.InstanceManager.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.launchBtn">
      <Setter Property="Background" Value="#1b2230" />
      <Setter Property="BorderBrush" Value="#2d3a52" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.launchBtn:pointerover">
      <Setter Property="Background" Value="#22304a" />
      <Setter Property="BorderBrush" Value="#3d5274" />
    </Style>
    <Style Selector="Button.launchBtn:pressed">
      <Setter Property="Background" Value="#141d2d" />
    </Style>
    <Style Selector="Button.launchBtn:disabled">
      <Setter Property="Background" Value="#171b24" />
      <Setter Property="BorderBrush" Value="#252d3c" />
      <Setter Property="Foreground" Value="#586276" />
    </Style>
    <!-- Rows span the project panel edge to edge, so the hover background, divider and selection band all reach the
         project border. -->
    <Style Selector="Border.cardPanel">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.cardPanel:pointerover">
      <Setter Property="Background" Value="#141a26" />
    </Style>
    <!-- Every row, including the first, has a divider above it. -->
    <Style Selector="Border.cardDivider">
      <Setter Property="Height" Value="2" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Selected conversation: a full-width band between the dividers. #424242 keeps the dimmest text (#AAB3C5 model
         name) at about 4.8:1 contrast. -->
    <Style Selector="Border.cardSelection">
      <Setter Property="Background" Value="#424242" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- The project panel has no horizontal padding; the header and row content carry the inset instead (2px border +
         8px, plus the row's own 10px). -->
    <Style Selector="Border.projectPanel">
      <Setter Property="Background" Value="#11151e" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0,8,0,6" />
    </Style>
    <Style Selector="Border.projectPanel Grid.projectHeader">
      <Setter Property="Margin" Value="10,0,8,6" />
    </Style>
    <Style Selector="Border.projectPanel StackPanel.cardContent">
      <Setter Property="Margin" Value="18,9" />
    </Style>
    <!-- Project holding the selected conversation: triple border, with padding and insets reduced by the extra 4px so
         the content doesn't shift. -->
    <Style Selector="Border.projectPanel.selected">
      <Setter Property="BorderThickness" Value="6" />
      <Setter Property="Padding" Value="0,4,0,2" />
    </Style>
    <Style Selector="Border.projectPanel.selected Grid.projectHeader">
      <Setter Property="Margin" Value="6,0,4,6" />
    </Style>
    <Style Selector="Border.projectPanel.selected StackPanel.cardContent">
      <Setter Property="Margin" Value="14,9" />
    </Style>
    <Style Selector="Border.linkedBadge">
      <Setter Property="Background" Value="#173429" />
      <Setter Property="BorderBrush" Value="#2B8059" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="Border.dropIndicator">
      <Setter Property="Height" Value="3" />
      <Setter Property="Background" Value="#4A90E2" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,0" />
      <Setter Property="ZIndex" Value="10" />
    </Style>
    <Style Selector="Button.stopBtn">
      <Setter Property="Background" Value="#271416" />
      <Setter Property="BorderBrush" Value="#7a2e38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFB8C0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.stopBtn:pointerover">
      <Setter Property="Background" Value="#3a1b20" />
      <Setter Property="Foreground" Value="#FFD7DC" />
    </Style>
    <Style Selector="Button.stopBtn:disabled">
      <Setter Property="Background" Value="#20191d" />
      <Setter Property="Foreground" Value="#586276" />
    </Style>
    <Style Selector="Button.secondaryBtn">
      <Setter Property="Background" Value="#1b2230" />
      <Setter Property="BorderBrush" Value="#3d4a66" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#DDE5F2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.secondaryBtn:pointerover">
      <Setter Property="Background" Value="#22304a" />
    </Style>
    <Style Selector="Button.secondaryBtn:disabled">
      <Setter Property="Background" Value="#171b24" />
      <Setter Property="Foreground" Value="#586276" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ProgressBar.turnProgressBar">
      <Setter Property="Foreground" Value="#FFB454" />
      <Setter Property="Background" Value="#271f14" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Application.Styles>
</Application>