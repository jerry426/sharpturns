<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpTurns.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111318" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#151820" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#171A22" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2D3548" />
      <SolidColorBrush x:Key="DestructiveBackgroundBrush" Color="#270000" />
      <!-- Text*Brush resources follow the Text slider (ConversationDisplayViewModel), so use them through DynamicResource. -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FB" />
      <SolidColorBrush x:Key="TextPrimaryAltBrush" Color="#E8EDF7" />
      <SolidColorBrush x:Key="TextStrongBrush" Color="#EEF2FA" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFD7E6" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#AAB3C5" />
      <SolidColorBrush x:Key="TextSubtleBrush" Color="#8792A8" />
      <SolidColorBrush x:Key="TextCyanBrush" Color="#12D6E7" />
      <SolidColorBrush x:Key="TextBlueMutedBrush" Color="#C7D7FF" />
      <SolidColorBrush x:Key="TextBlueSoftBrush" Color="#66B3FF" />
      <SolidColorBrush x:Key="TextBlueMetricBrush" Color="#60A5FA" />
      <SolidColorBrush x:Key="TextGreenBrush" Color="#8FD19E" />
      <!-- Tool card greens. -->
      <SolidColorBrush x:Key="TextGreenAccentBrush" Color="#42E38F" />
      <SolidColorBrush x:Key="TextGreenLightBrush" Color="#D9FBE7" />
      <SolidColorBrush x:Key="TextGreenPreviewBrush" Color="#86D8AF" />
      <SolidColorBrush x:Key="TextPurpleBrush" Color="#C9B8FF" />
      <SolidColorBrush x:Key="TextYellowBrush" Color="#E5C07B" />
      <SolidColorBrush x:Key="TextDangerBrush" Color="#FFB8C0" />
      <SolidColorBrush x:Key="TextDangerStrongBrush" Color="#FFD7DC" />
      <SolidColorBrush x:Key="TextDangerDisabledBrush" Color="#816E75" />
      <SolidColorBrush x:Key="ProminentTabAccentBrush" Color="#CFAC01" />
      <!-- Conversation display settings; ConversationDisplayViewModel replaces these with the Font and BG sliders' values. -->
      <x:Double x:Key="ConversationFontSize">15</x:Double>
      <x:Double x:Key="ConversationLineHeight">22</x:Double>
      <x:Double x:Key="ConversationCodeFontSize">13</x:Double>
      <x:Double x:Key="ConversationTextIntensity">0.9</x:Double>
      <FontFamily x:Key="ConversationFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <SolidColorBrush x:Key="TurnBackgroundBrush" Color="#151923" />
      <SolidColorBrush x:Key="CompressedTurnBackgroundBrush" Color="#0E1B2A" />
      <!-- Icon-only buttons must not depend on the UI font's symbol coverage. -->
      <StreamGeometry x:Key="EditIconGeometry">M2,14 L12,4 L16,8 L6,18 L1,19 Z M13,3 L15,1 L19,5 L17,7 Z</StreamGeometry>
      <StreamGeometry x:Key="DeleteIconGeometry">M8,2 H16 V4 H21 V6 H3 V4 H8 Z M5,8 H19 L18,22 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="RemoveIconGeometry">M0,0 L8,8 M8,0 L0,8</StreamGeometry>
      <!-- Search icons. -->
      <StreamGeometry x:Key="SearchIconGeometry">F0 M16,9 A7,7 0 1 1 2,9 A7,7 0 1 1 16,9 Z M14,9 A5,5 0 1 0 4,9 A5,5 0 1 0 14,9 Z M14,12 L22,20 L20,22 L12,14 Z</StreamGeometry>
      <StreamGeometry x:Key="UpTriangleIconGeometry">M0,8 L6,0 L12,8 Z</StreamGeometry>
      <StreamGeometry x:Key="DownTriangleIconGeometry">M0,0 L12,0 L6,8 Z</StreamGeometry>
      <StreamGeometry x:Key="CloseIconGeometry">M0,2 L2,0 L6,4 L10,0 L12,2 L8,6 L12,10 L10,12 L6,8 L2,12 L0,10 L4,6 Z</StreamGeometry>
      <!-- Colors LiveMarkdown's code blocks, quotes, and inline code use. -->
      <Color x:Key="BorderColor">#2D3548</Color>
      <Color x:Key="ForegroundColor">#EEF2FA</Color>
      <Color x:Key="CardBackgroundColor">#151923</Color>
      <Color x:Key="SecondaryCardBackgroundColor">#030406</Color>
      <Color x:Key="CodeInlineColor">#E5C07B</Color>
      <Color x:Key="QuoteBorderColor">#61AFEF</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://SharpTurns.Markdown.Rendering/Styles/MarkdownStyles.axaml" />

    <Style Selector="ScrollViewer">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="Button.primaryActionButton, Button.secondaryActionButton, Button.dangerActionButton">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.primaryActionButton /template/ ContentPresenter#PART_ContentPresenter, Button.secondaryActionButton /template/ ContentPresenter#PART_ContentPresenter, Button.dangerActionButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primaryActionButton">
      <Setter Property="Background" Value="#0969DA" />
      <Setter Property="BorderBrush" Value="#2B8CFF" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.primaryActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1177D8" />
      <Setter Property="BorderBrush" Value="#4AA3FF" />
    </Style>
    <Style Selector="Button.primaryActionButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#253044" />
      <Setter Property="BorderBrush" Value="#344158" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>

    <Style Selector="Button.secondaryActionButton">
      <Setter Property="Background" Value="#182235" />
      <Setter Property="BorderBrush" Value="#2D3A52" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.secondaryActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#21304A" />
      <Setter Property="BorderBrush" Value="#3D5274" />
    </Style>
    <Style Selector="Button.secondaryActionButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#171B24" />
      <Setter Property="BorderBrush" Value="#252D3C" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>

    <Style Selector="Button.dangerActionButton">
      <Setter Property="Background" Value="{StaticResource DestructiveBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="#7A2E38" />
      <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
    </Style>
    <Style Selector="Button.dangerActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A1B20" />
      <Setter Property="BorderBrush" Value="#A6424F" />
      <Setter Property="Foreground" Value="{DynamicResource TextDangerStrongBrush}" />
    </Style>
    <Style Selector="Button.dangerActionButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20191D" />
      <Setter Property="BorderBrush" Value="#443039" />
      <Setter Property="Foreground" Value="{DynamicResource TextDangerDisabledBrush}" />
    </Style>

    <!-- Turn card rail actions. -->
    <Style Selector="Button.railButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#D9E4F7" />
    </Style>
    <Style Selector="Button.railButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.railButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#F4F8FF" />
    </Style>
    <Style Selector="Button.railButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#171B24" />
      <Setter Property="BorderBrush" Value="#252D3C" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>

    <Style Selector="Button.railButton.copy">
      <Setter Property="Background" Value="#123F1A" />
      <Setter Property="BorderBrush" Value="#2B8C3A" />
    </Style>
    <Style Selector="Button.railButton.copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1B5E27" />
      <Setter Property="BorderBrush" Value="#3FBC52" />
    </Style>
    <Style Selector="Button.railButton.copy:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0C2D12" />
      <Setter Property="BorderBrush" Value="#1F6F2B" />
    </Style>

    <Style Selector="Button.railButton.export">
      <Setter Property="Background" Value="#0F3444" />
      <Setter Property="BorderBrush" Value="#00A2C7" />
    </Style>
    <Style Selector="Button.railButton.export:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#164A61" />
      <Setter Property="BorderBrush" Value="#2AC8EE" />
    </Style>
    <Style Selector="Button.railButton.export:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0A2530" />
      <Setter Property="BorderBrush" Value="#007D99" />
    </Style>

    <Style Selector="Button.railButton.branch">
      <Setter Property="Background" Value="#2A2410" />
      <Setter Property="BorderBrush" Value="#DAAE00" />
      <Setter Property="Foreground" Value="#DAAE00" />
    </Style>
    <Style Selector="Button.railButton.branch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3D3414" />
      <Setter Property="BorderBrush" Value="#FFD92E" />
      <Setter Property="Foreground" Value="#FFD92E" />
    </Style>
    <Style Selector="Button.railButton.branch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E1A0B" />
      <Setter Property="BorderBrush" Value="#CCA300" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Compress, Hide, and Delete share one row of small buttons. -->
    <Style Selector="Button.railButton.small">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style Selector="Button.railButton.compress">
      <Setter Property="Background" Value="#123F1A" />
      <Setter Property="BorderBrush" Value="#21E786" />
    </Style>
    <Style Selector="Button.railButton.compress:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#164F22" />
      <Setter Property="BorderBrush" Value="#4CFFAA" />
    </Style>
    <Style Selector="Button.railButton.compress:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0F3315" />
      <Setter Property="BorderBrush" Value="#18B766" />
    </Style>

    <Style Selector="Button.railButton.hide">
      <Setter Property="Background" Value="#0B3857" />
      <Setter Property="BorderBrush" Value="#008AD8" />
    </Style>
    <Style Selector="Button.railButton.hide:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#104D75" />
      <Setter Property="BorderBrush" Value="#19A8FF" />
    </Style>
    <Style Selector="Button.railButton.hide:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#082B42" />
      <Setter Property="BorderBrush" Value="#006FAE" />
    </Style>

    <!-- View Full Turn Content and Restore Compressed View; the large ones sit in the content column. -->
    <Style Selector="Button.railButton.viewFull">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Background" Value="#153D5A" />
      <Setter Property="BorderBrush" Value="#0078D4" />
      <Setter Property="Foreground" Value="#0EA5FF" />
    </Style>
    <Style Selector="Button.railButton.viewFull:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1C537A" />
      <Setter Property="BorderBrush" Value="#1EA7FF" />
      <Setter Property="Foreground" Value="#34B7FF" />
    </Style>
    <Style Selector="Button.railButton.viewFull:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#102E44" />
      <Setter Property="BorderBrush" Value="#005A9E" />
      <Setter Property="Foreground" Value="#BCE7FF" />
    </Style>

    <Style Selector="Button.railButton.restore">
      <Setter Property="Background" Value="#2C2923" />
      <Setter Property="BorderBrush" Value="#5D5549" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.railButton.restore:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3B372F" />
      <Setter Property="BorderBrush" Value="#7B705F" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.railButton.restore:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#201E19" />
      <Setter Property="BorderBrush" Value="#453F35" />
    </Style>

    <Style Selector="Button.railButton.large">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="Button.railButton.delete">
      <Setter Property="Background" Value="#561010" />
      <Setter Property="BorderBrush" Value="#B31616" />
    </Style>
    <Style Selector="Button.railButton.delete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#741717" />
      <Setter Property="BorderBrush" Value="#FF4D4D" />
    </Style>
    <Style Selector="Button.railButton.delete:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3F0B0B" />
      <Setter Property="BorderBrush" Value="#8F1111" />
    </Style>

    <!-- Composer action buttons: neutral by default, plus undo (gold), stop (red), and image. -->
    <Style Selector="Button.composerButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#17212B" />
      <Setter Property="BorderBrush" Value="#3A465C" />
      <Setter Property="Foreground" Value="#D9E4F7" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="Button.composerButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.composerButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#213247" />
      <Setter Property="BorderBrush" Value="#5D6D89" />
      <Setter Property="Foreground" Value="#F4F8FF" />
    </Style>
    <Style Selector="Button.composerButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#111924" />
      <Setter Property="BorderBrush" Value="#2E394E" />
    </Style>
    <Style Selector="Button.composerButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#171B24" />
      <Setter Property="BorderBrush" Value="#252D3C" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>

    <Style Selector="Button.composerButton.undo">
      <Setter Property="Background" Value="#2D2410" />
      <Setter Property="BorderBrush" Value="#A77C1E" />
      <Setter Property="Foreground" Value="#F8D37A" />
    </Style>
    <Style Selector="Button.composerButton.undo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#443518" />
      <Setter Property="BorderBrush" Value="#D7A52C" />
      <Setter Property="Foreground" Value="#FFE8A3" />
    </Style>
    <Style Selector="Button.composerButton.undo:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#3D3420" />
    </Style>

    <Style Selector="Button.composerButton.stop">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#F2385A" />
      <Setter Property="BorderBrush" Value="#FF637B" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.composerButton.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF4F6C" />
      <Setter Property="BorderBrush" Value="#FF8A9D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.composerButton.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C91F42" />
      <Setter Property="BorderBrush" Value="#B91D3D" />
    </Style>
    <Style Selector="Button.composerButton.stop:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A1A22" />
      <Setter Property="BorderBrush" Value="#4A2A35" />
    </Style>

    <Style Selector="Button.composerButton.image">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="#171717" />
      <Setter Property="BorderBrush" Value="#3A3F4B" />
      <Setter Property="Foreground" Value="#D9D9DE" />
    </Style>
    <Style Selector="Button.composerButton.image:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#24262D" />
      <Setter Property="BorderBrush" Value="#636C7F" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.composerButton.image:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#101014" />
      <Setter Property="BorderBrush" Value="#2D3340" />
    </Style>

    <!-- Images Available for Replay: a dark red border, or a thick green one while images are
         being replayed, that stays on hover. -->
    <Style Selector="Button.replayImages">
      <Setter Property="BorderBrush" Value="#633C40" />
    </Style>
    <Style Selector="Button.replayImages:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#633C40" />
    </Style>
    <Style Selector="Button.replayImages.replaying">
      <Setter Property="BorderBrush" Value="#00FF00" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.replayImages.replaying:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#00FF00" />
    </Style>

    <!-- The conversation header's Markdown, Mono, and Auto-scroll toggles. -->
    <Style Selector="ToggleButton.headerToggle">
      <Setter Property="Background" Value="#182235" />
      <Setter Property="BorderBrush" Value="#2D3A52" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="ToggleButton.headerToggle /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ToggleButton.headerToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0969DA" />
      <Setter Property="BorderBrush" Value="#12D6E7" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.headerToggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1177D8" />
      <Setter Property="BorderBrush" Value="#4AA3FF" />
    </Style>
    <Style Selector="ToggleButton.headerToggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#084D91" />
      <Setter Property="BorderBrush" Value="#1B6FC7" />
    </Style>

    <!-- The conversation header's action buttons, each in its own color. -->
    <Style Selector="Button.headerButton">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="Button.headerButton /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.headerButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#171B18" />
      <Setter Property="BorderBrush" Value="#293246" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>
    <Style Selector="Button.headerButton.history">
      <Setter Property="Background" Value="#14243A" />
      <Setter Property="BorderBrush" Value="#66A3FF" />
    </Style>
    <Style Selector="Button.headerButton.history:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1B3352" />
      <Setter Property="BorderBrush" Value="#9BC4FF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.headerButton.history:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0E1A2B" />
      <Setter Property="BorderBrush" Value="#417FD6" />
    </Style>
    <Style Selector="Button.headerButton.notes">
      <Setter Property="Background" Value="#111A2E" />
      <Setter Property="BorderBrush" Value="#7EA0FF" />
    </Style>
    <Style Selector="Button.headerButton.notes:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18264A" />
      <Setter Property="BorderBrush" Value="#AFC3FF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.headerButton.notes:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0C1324" />
      <Setter Property="BorderBrush" Value="#5577FF" />
    </Style>
    <Style Selector="Button.headerButton.export">
      <Setter Property="Background" Value="#1E2B12" />
      <Setter Property="BorderBrush" Value="#BFFF97" />
    </Style>
    <Style Selector="Button.headerButton.export:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2B3D18" />
      <Setter Property="BorderBrush" Value="#D2FFB5" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.headerButton.export:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#17210E" />
      <Setter Property="BorderBrush" Value="#97CC71" />
    </Style>
    <Style Selector="Button.headerButton.viewer">
      <Setter Property="Background" Value="#2B2410" />
      <Setter Property="BorderBrush" Value="#FFE066" />
    </Style>
    <Style Selector="Button.headerButton.viewer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#403516" />
      <Setter Property="BorderBrush" Value="#FFF0A3" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.headerButton.viewer:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#201A0B" />
      <Setter Property="BorderBrush" Value="#D6B52E" />
    </Style>

    <Style Selector="TextBlock.metricLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <!-- Collapsible card headers: the whole row toggles; no accent fill when expanded. -->
    <Style Selector="ToggleButton.cardHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.cardHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.cardHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A2130" />
    </Style>
    <Style Selector="ToggleButton.cardHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#151B27" />
    </Style>
    <!-- Tool cards are green, so their header hovers in green. -->
    <Style Selector="ToggleButton.cardHeader.toolHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0F4232" />
    </Style>
    <Style Selector="ToggleButton.cardHeader.toolHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0A2E23" />
    </Style>

    <Style Selector="TextBlock.chevron">
      <Setter Property="Text" Value="›" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Width" Value="10" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="TextBlock.chevron.expanded">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>

    <Style Selector="TextBlock.toolStatus">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
    </Style>
    <Style Selector="TextBlock.toolStatus.running">
      <Setter Property="Foreground" Value="{DynamicResource TextCyanBrush}" />
    </Style>
    <Style Selector="TextBlock.toolStatus.waiting">
      <Setter Property="Foreground" Value="{DynamicResource TextYellowBrush}" />
    </Style>
    <Style Selector="TextBlock.toolStatus.succeeded">
      <Setter Property="Foreground" Value="{DynamicResource TextGreenBrush}" />
    </Style>
    <Style Selector="TextBlock.toolStatus.failed">
      <Setter Property="Foreground" Value="{DynamicResource TextDangerBrush}" />
    </Style>

    <Style Selector="TextBlock.detailLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.thumbnail">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#0F141C" />
      <Setter Property="BorderBrush" Value="#2D3548" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- The remove button on composer and gallery thumbnails. Its X is a drawn Path (RemoveIconGeometry),
         which stays centered in the circle; the "×" glyph's font metrics do not. -->
    <Style Selector="Button.removeImage">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3,3,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#C0000000" />
      <Setter Property="BorderBrush" Value="#F2385A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.removeImage Path">
      <Setter Property="Data" Value="{StaticResource RemoveIconGeometry}" />
      <Setter Property="Stroke" Value="White" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>

    <!-- Main tab strip: the selected tab is filled yellow with black text and no underline.
         Header TextBlocks must not set their own Foreground, or the black won't apply. -->
    <Style Selector="TabControl.mainTabs TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,4,10,4" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TabControl.mainTabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TabControl.mainTabs /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="TabControl.mainTabs TabItem:selected /template/ Border#PART_LayoutRoot,
                      TabControl.mainTabs TabItem:selected:pointerover /template/ Border#PART_LayoutRoot,
                      TabControl.mainTabs TabItem:selected:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ProminentTabAccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="Black" />
      <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>
    <!-- A step above the theme's SemiLight, so the black text holds up on the yellow. -->
    <Style Selector="TabControl.mainTabs TabItem:selected">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TabControl.mainTabs TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Selectable project and conversation cards: the card's own border shows; the button adds no chrome. -->
    <Style Selector="Button.cardButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.cardButton /template/ ContentPresenter#PART_ContentPresenter,
                      Button.cardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                      Button.cardButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.cardButton:pointerover Border.card">
      <Setter Property="Background" Value="#20242E" />
    </Style>
    <Style Selector="Button.cardButton:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#191919" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style Selector="TextBlock.cardLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextCyanBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.cardValue">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- On/off setting label colors. -->
    <Style Selector="TextBlock.settingLabel">
      <Setter Property="Foreground" Value="#E55353" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.settingLabel.on">
      <Setter Property="Foreground" Value="#00B00C" />
    </Style>

    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
