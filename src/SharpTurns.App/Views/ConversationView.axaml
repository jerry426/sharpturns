<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cli="using:SharpTurns.ClaudeCli"
             xmlns:fonts="using:SharpTurns.Markdown.Rendering.Styling"
             xmlns:markdown="using:SharpTurns.Markdown.Rendering"
             xmlns:views="using:SharpTurns.App.Views"
             xmlns:vm="using:SharpTurns.App.ViewModels"
             x:Class="SharpTurns.App.Views.ConversationView"
             x:DataType="vm:ConversationViewModel">
  <UserControl.Resources>
    <!-- A composer thumbnail opens an editable gallery of the composer's images; each also has a remove button. -->
    <DataTemplate x:Key="ComposerImageTemplate" x:DataType="vm:ImageAttachmentViewModel">
      <Button Classes="thumbnail" Width="96" Height="72" Click="Image_Click" ToolTip.Tip="{Binding ToolTip}">
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The BG slider scales these backgrounds. -->
    <Style Selector="Border.turnCard">
      <Setter Property="Background" Value="{DynamicResource TurnBackgroundBrush}" />
    </Style>
    <Style Selector="Border.turnCard.compressed">
      <Setter Property="Background" Value="{DynamicResource CompressedTurnBackgroundBrush}" />
    </Style>
    <!-- The cards' read-only text boxes look like text when hovered or focused, without the theme's input box size. -->
    <Style Selector="TextBox.plainText">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox.plainText /template/ Border#PART_BorderElement, TextBox.plainText:pointerover /template/ Border#PART_BorderElement, TextBox.plainText:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.searchButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- The display toggles, as in the Workbench. They and the Show picker apply to every conversation. The title and
         workspace are in the sidebar's conversation card, so the header shows only the status. Markdown Viewer and
         the second row's buttons sit at the right, as in the Workbench. -->
    <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
      <WrapPanel VerticalAlignment="Center">
        <ToggleButton Classes="headerToggle" Content="Markdown" IsChecked="{Binding Display.IsMarkdownRenderingEnabled, Mode=TwoWay}"
                      Margin="0,0,6,0" ToolTip.Tip="Render responses as Markdown; off, show their Markdown source" />
        <ToggleButton Classes="headerToggle" Content="{}{} Mono" IsChecked="{Binding Display.IsMonospaceFontEnabled, Mode=TwoWay}"
                      Margin="0,0,6,0" ToolTip.Tip="Show prompts and responses in a monospace font" />
        <ToggleButton Classes="headerToggle" Content="📋 Work Summary" IsChecked="{Binding Display.IsWorkSummaryExpanded, Mode=TwoWay}"
                      Margin="0,0,6,0" ToolTip.Tip="Open or close the Work Summary on every compressed turn" />
        <ToggleButton Classes="headerToggle" Content="Auto-scroll" IsChecked="{Binding Display.IsAutoScrollEnabled, Mode=TwoWay}"
                      Margin="0,0,6,0"
                      ToolTip.Tip="Keep the conversation scrolled to the bottom while a turn runs; off, the scroll stays where you leave it" />
      </WrapPanel>
      <TextBlock Grid.Column="1" Text="{Binding Status}" MaxWidth="560" HorizontalAlignment="Right"
                 Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
      <Button Grid.Column="2" Classes="headerButton viewer" Content="📖 Markdown Viewer" Command="{Binding OpenMarkdownViewerCommand}"
              ToolTip.Tip="Open the Markdown Viewer on this project's documentation" />
      <!-- Search in turns, as in the Workbench. The search and the active match are shared by every conversation. -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <PathIcon Width="13" Height="13" Data="{StaticResource SearchIconGeometry}" Foreground="{DynamicResource TextMutedBrush}"
                  VerticalAlignment="Center" Margin="0,0,2,0" />
        <TextBox x:Name="SearchBox" Text="{Binding Display.SearchQuery}" PlaceholderText="Search in turns..." Width="220"
                 MinHeight="26" FontSize="12" KeyDown="SearchBox_KeyDown"
                 ToolTip.Tip="Search the shown turns, including open tool cards. Enter = next match, Shift+Enter = previous match." />
        <Button Classes="secondaryActionButton searchButton" Command="{Binding Display.PreviousSearchMatchCommand}"
                IsVisible="{Binding Display.IsSearchActive}" ToolTip.Tip="Previous match (Shift+Enter)">
          <PathIcon Width="10" Height="8" Data="{StaticResource UpTriangleIconGeometry}" />
        </Button>
        <Button Classes="secondaryActionButton searchButton" Command="{Binding Display.NextSearchMatchCommand}"
                IsVisible="{Binding Display.IsSearchActive}" ToolTip.Tip="Next match (Enter)">
          <PathIcon Width="10" Height="8" Data="{StaticResource DownTriangleIconGeometry}" />
        </Button>
        <Button Classes="secondaryActionButton searchButton" Command="{Binding Display.ClearSearchCommand}"
                IsVisible="{Binding Display.IsSearchActive}" ToolTip.Tip="Clear search">
          <PathIcon Width="12" Height="12" Data="{StaticResource CloseIconGeometry}" />
        </Button>
        <TextBlock Text="{Binding Display.SearchMatchStatusLabel}" IsVisible="{Binding Display.IsSearchActive}"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" MinWidth="60"
                   Margin="4,0,0,0" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right">
        <Button Classes="headerButton history" Content="💬 User Message History" Command="{Binding OpenUserMessageHistoryCommand}"
                ToolTip.Tip="Browse the user messages in Claude's context" />
        <Button Classes="headerButton notes" Content="{Binding NotesLabel}" Command="{Binding OpenNotesCommand}"
                ToolTip.Tip="{Binding NotesToolTip}" />
        <Button Classes="headerButton export" Content="📤 Export" Command="{Binding ExportConversationCommand}"
                ToolTip.Tip="Export the conversation to Markdown, text, MacDown, or DOCX" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,8,0,0" Background="#151820" BorderBrush="#303645" BorderThickness="1" CornerRadius="4"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
        <TextBlock Text="Show:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Display.TurnFilterOptions}"
                  SelectedIndex="{Binding Display.TurnFilterIndex, Mode=TwoWay}" Width="140" MinHeight="28" FontSize="12"
                  ToolTip.Tip="Show all turns, the turns in Claude's context, or the hidden ones" />
        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Classes="metricLabel" Text="Last Reported Input:"
                     ToolTip.Tip="Input tokens of the latest turn's last model request, including cache reads and writes" />
          <TextBlock Classes="metricValue" Text="{Binding LastReportedInputLabel}" Foreground="{DynamicResource TextPrimaryAltBrush}"
                     ToolTip.Tip="Input tokens of the latest turn's last model request, including cache reads and writes" />
          <TextBlock Classes="metricLabel" Text="Turns Total:" />
          <TextBlock Classes="metricValue" Text="{Binding TurnsTotalLabel}" Foreground="{DynamicResource TextPrimaryAltBrush}" />
          <TextBlock Classes="metricLabel" Text="Turns Visible:" />
          <TextBlock Classes="metricValue" Text="{Binding TurnsVisibleLabel}" Foreground="{DynamicResource TextGreenBrush}" />
          <TextBlock Classes="metricLabel" Text="Turns Compressed:" />
          <TextBlock Classes="metricValue" Text="{Binding TurnsCompressedLabel}" Foreground="{DynamicResource TextPurpleBrush}" />
          <TextBlock Classes="metricLabel" Text="Turns Hidden:" />
          <TextBlock Classes="metricValue" Text="{Binding TurnsHiddenLabel}" Foreground="{DynamicResource TextBlueMetricBrush}"
                     Margin="0" />
        </WrapPanel>
      </Grid>
    </Border>

    <!-- As in the Workbench, the Conversation Turns and Context Management tabs sit under a yellow line, above the
         composer. The tab strip only switches which panel is visible, so the turn cards stay rendered and keep their
         scroll position while Context Management is open. The view is reused across conversations, so the chosen tab
         carries over, as in the Workbench. -->
    <Grid Grid.Row="2" Margin="0,12,0,10" RowDefinitions="2,Auto,*">
      <Border Background="{StaticResource ProminentTabAccentBrush}" />
      <TabControl Grid.Row="1" Classes="mainTabs" Padding="0">
        <TabItem x:Name="TurnsTab" Header="Conversation Turns" FontSize="13" />
        <TabItem x:Name="ContextTab" Header="Context Management" FontSize="13" />
      </TabControl>
      <views:ContextManagementView Grid.Row="2" IsVisible="{Binding #ContextTab.IsSelected}" />

      <!-- The turns sit in a card; the right padding and item margin leave room for the scrollbar. -->
      <Border Grid.Row="2" IsVisible="{Binding #TurnsTab.IsSelected}" Background="{StaticResource CardBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,10,18,10">
        <ScrollViewer x:Name="TurnsScroller">
          <ItemsControl x:Name="TurnsList" ItemsSource="{Binding ShownTurns}" Margin="0,0,14,0">
            <ItemsControl.ItemTemplate>
              <!-- Each turn is a card, laid out like the Workbench's: a rail with the turn's details and actions, then
                   the prompt and response. A compressed turn has a darker blue card; a hidden turn has a thick orange border. -->
              <DataTemplate x:DataType="vm:TurnViewModel">
                <Border Classes="turnCard" Classes.compressed="{Binding IsCompressed}" Margin="0,0,0,14"
                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="14">
                  <Grid ColumnDefinitions="268,*">
                    <Border BorderBrush="{Binding RailDividerBrush}" BorderThickness="0,0,1,0" Padding="14">
                      <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <Border Background="#1D2A44" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TurnLabel}" Foreground="{Binding RailAccentBrush}" FontSize="11"
                                       FontWeight="SemiBold" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding IdLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                     VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource TextStrongBrush}" FontSize="13" />
                        <TextBlock Text="{Binding DurationLabel}" IsVisible="{Binding HasDuration}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        <StackPanel IsVisible="{Binding HasTokenUsage}" Spacing="3">
                          <TextBlock Text="{Binding InputTokensLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding OutputTokensLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                          <TextBlock Text="Cumulative across model requests" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                     ToolTip.Tip="Totals sum the usage the CLI reported across this turn's model requests. Input includes context processed again on each request, not just new tool results." />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HasTokenUsage}" Spacing="4">
                          <TextBlock Text="{Binding CacheHitLabel}" Foreground="#3FA568" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CacheMissLabel}" Foreground="#A65D63" FontSize="12" TextWrapping="Wrap" />
                          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CacheHitPercentage}" Height="10" MinHeight="0"
                                       CornerRadius="0" Foreground="#3FA568" Background="#A65D63" />
                        </StackPanel>
                        <TextBlock Text="{Binding FirstRequestCacheLabel}" IsVisible="{Binding HasTokenUsage}" Foreground="#3FA568"
                                   FontSize="12" TextWrapping="Wrap"
                                   ToolTip.Tip="Cached input divided by total input on the turn's first model request, before any tool calls: how much of the resumed or reseeded context the cache served." />
                        <TextBlock Text="{Binding ContextLabel}" IsVisible="{Binding HasContext}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   ToolTip.Tip="Input size of the turn's last model request: how much context the conversation now uses." />
                        <TextBlock Text="Hidden from Claude's context" IsVisible="{Binding !IsHydrated}" Foreground="#F89831"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CompressedLabel}" IsVisible="{Binding IsCompressed}" Foreground="#1EA7FF"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <Button Classes="railButton copy" Content="📋 Copy Metrics"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.CopyMetricsCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Copy the details shown here as text" />
                        <Grid ColumnDefinitions="72,72,72" ColumnSpacing="6" Margin="0,5,0,0">
                          <Button Classes="railButton small compress" Content="{Binding CompressionActionLabel}"
                                  Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleCompressionCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{Binding CompressionActionToolTip}" />
                          <Button Grid.Column="1" Classes="railButton small hide" Content="{Binding HydrationActionLabel}"
                                  Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleHydrationCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{Binding HydrationActionToolTip}" />
                          <Button Grid.Column="2" Classes="railButton small delete" Content="Delete"
                                  Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteTurnCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Delete this turn and everything saved with it" />
                        </Grid>
                        <Button Classes="railButton copy" Content="📋 Copy Turn"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.CopyTurnCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Copy the prompt and response as shown (the summary when compressed) as Markdown, without tool activity" />
                        <Button Classes="railButton export" Content="📤 Export / MacDown / DOCX"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.ExportTurnCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Open export options for Markdown, MacDown, text, and DOCX" />
                        <Button Classes="railButton branch dictationLocked" Content="{Binding BranchEndpointLabel}"
                                Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleBranchEndpointCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Mark this turn as a branch endpoint. Select two endpoints to create a branched conversation from the inclusive range." />
                        <Button Classes="railButton viewFull" Content="{Binding CompactViewFullContentLabel}"
                                IsVisible="{Binding HasViewFullContentButton}" Command="{Binding ViewFullContentCommand}"
                                ToolTip.Tip="{Binding ReductionToolTip}" />
                        <Button Classes="railButton restore" Content="📦 Restore Compressed View"
                                IsVisible="{Binding IsViewingFullCompressedContent}" Command="{Binding RestoreCompressedViewCommand}"
                                ToolTip.Tip="Return this card to its compressed view without changing what's saved" />
                      </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16" Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding ModelLabel}" IsVisible="{Binding HasModel}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="railButton viewFull large" Content="{Binding ViewFullContentLabel}"
                                IsVisible="{Binding HasViewFullContentButton}" Command="{Binding ViewFullContentCommand}"
                                ToolTip.Tip="{Binding ReductionToolTip}" />
                      </Grid>
                      <Border IsVisible="{Binding IsViewingFullCompressedContent}" Background="#0F1C2A" BorderBrush="#0078D4"
                              BorderThickness="2" CornerRadius="8" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock Text="📖 Temporarily expanded - viewing full content (will revert to compressed view on reload)"
                                     Foreground="{DynamicResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"
                                     TextWrapping="Wrap" />
                          <Button Grid.Column="1" Classes="railButton restore large" Content="📦 Restore Compressed View"
                                  Command="{Binding RestoreCompressedViewCommand}"
                                  ToolTip.Tip="Return this card to its compressed view without changing what's saved" />
                        </Grid>
                      </Border>
                      <TextBlock Text="USER:" Foreground="{DynamicResource TextYellowBrush}" FontSize="15" FontWeight="SemiBold" />
                      <!-- As in the Workbench, each image is a card above the prompt with its thumbnail, details, and replay choice. -->
                      <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TurnImageViewModel">
                            <Border Background="#1D2433" BorderBrush="#52607A" BorderThickness="1" CornerRadius="10" Padding="10"
                                    ToolTip.Tip="{Binding Preview.ToolTip}">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Button Classes="thumbnail" Width="160" Height="120" Click="Image_Click" ToolTip.Tip="Preview sent image">
                                  <Image Source="{Binding Preview.Thumbnail}" Stretch="UniformToFill" />
                                </Button>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Preview.ToolTip}" Foreground="{DynamicResource TextYellowBrush}" FontSize="13"
                                             FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding MediaType}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                             TextWrapping="Wrap" />
                                  <TextBlock Text="Click thumbnail to preview" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                                             TextWrapping="Wrap" />
                                  <CheckBox Content="{Binding ReplayChoiceLabel}" IsChecked="{Binding IncludeInFutureReplay, Mode=OneWay}"
                                            Command="{ReflectionBinding $parent[UserControl].DataContext.ToggleImageReplayCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{Binding ReplayChoiceToolTip}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- As in the Workbench, plain text is a read-only text box, so search can select its active match.
                           Each searchable control has a search class naming what it shows. -->
                      <markdown:HighlightableTextBlock Classes="plainText searchPrompt" Text="{Binding UserText, Mode=OneWay}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{DynamicResource ConversationFontFamily}"
                                                       FontSize="{DynamicResource ConversationFontSize}"
                                                       LineHeight="{DynamicResource ConversationLineHeight}" />
                      <Border Height="4" Background="{DynamicResource TextYellowBrush}" Margin="0,10,0,8" />
                      <TextBlock Text="ASSISTANT:" Foreground="#61AFEF" FontSize="15" FontWeight="SemiBold" />

                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                          <DataTemplate DataType="vm:TextItemViewModel" x:DataType="vm:TextItemViewModel">
                            <StackPanel Spacing="10">
                              <!-- As in the Workbench, a compressed card's Work Summary is a collapsible card above the
                                   response; the header's Work Summary toggle opens or closes them all. -->
                              <Border IsVisible="{Binding HasWorkSummary}" Background="#010D1D" BorderBrush="#9CA1A8" BorderThickness="1"
                                      CornerRadius="10">
                                <StackPanel>
                                  <ToggleButton Classes="cardHeader" IsChecked="{Binding IsExpanded}" CornerRadius="10" Padding="10,3"
                                                MinHeight="28">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                      <TextBlock Text="📋" FontSize="12" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="1" Text="{Binding WorkSummaryHeaderLabel}" Foreground="#00CCCC" FontSize="12"
                                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                      <TextBlock Grid.Column="2" Classes="chevron" Classes.expanded="{Binding IsExpanded}" Foreground="#FFFFFF" />
                                    </Grid>
                                  </ToggleButton>
                                  <Border IsVisible="{Binding IsExpanded}" BorderBrush="#9CA1A8" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9"
                                          Padding="12">
                                    <Panel>
                                      <markdown:MarkdownDocumentBlock Classes="conversationMarkdown searchWorkSummary" Markdown="{Binding WorkSummaryText}"
                                                                      IsVisible="{Binding $parent[UserControl].((vm:ConversationViewModel)DataContext).Display.IsMarkdownRenderingEnabled}"
                                                                      ContentForeground="{DynamicResource TextSecondaryBrush}"
                                                                      ContentFontFamily="{DynamicResource ConversationFontFamily}"
                                                                      ContentFontSize="{DynamicResource ConversationFontSize}"
                                                                      ContentLineHeight="{DynamicResource ConversationLineHeight}"
                                                                      CodeFontSize="{DynamicResource ConversationCodeFontSize}"
                                                                      TextIntensity="{DynamicResource ConversationTextIntensity}"
                                                                      CodeBlockColorTheme="DarkPlus" />
                                      <markdown:HighlightableTextBlock Classes="plainText searchWorkSummary" Text="{Binding WorkSummaryText, Mode=OneWay}"
                                                                       IsVisible="{Binding $parent[UserControl].((vm:ConversationViewModel)DataContext).Display.IsMarkdownSourceShown}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontFamily="{DynamicResource ConversationFontFamily}"
                                                                       FontSize="{DynamicResource ConversationFontSize}"
                                                                       LineHeight="{DynamicResource ConversationLineHeight}" />
                                    </Panel>
                                  </Border>
                                </StackPanel>
                              </Border>
                              <Panel>
                                <markdown:MarkdownDocumentBlock Classes="conversationMarkdown searchText" Markdown="{Binding PrimaryText}"
                                                                HighlightHybridCompressionSectionLabels="{Binding IsSummary}"
                                                                HybridCompressionSectionLabelForeground="#00CCCC"
                                                                ContentForeground="{DynamicResource TextSecondaryBrush}"
                                                                ContentFontFamily="{DynamicResource ConversationFontFamily}"
                                                                ContentFontSize="{DynamicResource ConversationFontSize}"
                                                                ContentLineHeight="{DynamicResource ConversationLineHeight}"
                                                                CodeFontSize="{DynamicResource ConversationCodeFontSize}"
                                                                TextIntensity="{DynamicResource ConversationTextIntensity}"
                                                                CodeBlockColorTheme="DarkPlus">
                                  <markdown:MarkdownDocumentBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                      <Binding Path="IsRendered" />
                                      <Binding Path="$parent[UserControl].((vm:ConversationViewModel)DataContext).Display.IsMarkdownRenderingEnabled" />
                                    </MultiBinding>
                                  </markdown:MarkdownDocumentBlock.IsVisible>
                                </markdown:MarkdownDocumentBlock>
                                <!-- Streaming text stays plain so each delta doesn't rebuild the rendered document. With the
                                     Markdown toggle off, every response shows its Markdown source this way. -->
                                <markdown:HighlightableTextBlock Classes="plainText searchText" Text="{Binding PrimaryText, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 FontFamily="{DynamicResource ConversationFontFamily}"
                                                                 FontSize="{DynamicResource ConversationFontSize}"
                                                                 LineHeight="{DynamicResource ConversationLineHeight}">
                                  <markdown:HighlightableTextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                      <Binding Path="IsStreaming" />
                                      <Binding Path="$parent[UserControl].((vm:ConversationViewModel)DataContext).Display.IsMarkdownSourceShown" />
                                    </MultiBinding>
                                  </markdown:HighlightableTextBlock.IsVisible>
                                </markdown:HighlightableTextBlock>
                              </Panel>
                            </StackPanel>
                          </DataTemplate>

                          <DataTemplate DataType="vm:ToolItemViewModel" x:DataType="vm:ToolItemViewModel">
                            <!-- The Workbench's tool card greens: header, border, and the expanded detail panel. -->
                            <Border Background="#0B3528" BorderBrush="#1C7A55" BorderThickness="1" CornerRadius="8">
                              <StackPanel>
                                <ToggleButton Classes="cardHeader toolHeader" IsChecked="{Binding IsExpanded}">
                                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding NumberLabel}" IsVisible="{Binding HasNumber}"
                                               Foreground="{DynamicResource TextGreenAccentBrush}" FontSize="13" FontWeight="SemiBold"
                                               MinWidth="22" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="chevron" Classes.expanded="{Binding IsExpanded}"
                                               Foreground="{DynamicResource TextGreenLightBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tool.Name}" Foreground="{DynamicResource TextGreenAccentBrush}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{DynamicResource TextGreenPreviewBrush}"
                                               FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12">
                                      <TextBlock Classes="toolStatus" Text="{Binding Tool.Status}"
                                                 Classes.running="{Binding IsRunning}" Classes.waiting="{Binding IsWaiting}"
                                                 Classes.succeeded="{Binding IsSucceeded}" Classes.failed="{Binding Tool.IsError}" />
                                      <TextBlock Text="{Binding CacheUsageBadge}" IsVisible="{Binding HasCacheUsage}"
                                                 ToolTip.Tip="{Binding CacheUsageToolTip}" Foreground="{DynamicResource TextGreenPreviewBrush}"
                                                 FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Grid>
                                </ToggleButton>
                                <Border IsVisible="{Binding IsExpanded}" Background="#0C1E18" BorderBrush="#1C7A55" BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,7,7" Padding="28,8,12,10">
                                  <StackPanel Spacing="6">
                                    <!-- As in the Workbench: Input's Show Full sits beside its label, Result's at the right. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Classes="detailLabel" Text="Input" Foreground="{DynamicResource TextGreenAccentBrush}"
                                                 VerticalAlignment="Center" />
                                      <ToggleButton Classes="headerToggle" Content="{Binding InputToggleLabel}"
                                                    IsChecked="{Binding ShowFullInput}" IsVisible="{Binding HasTruncatedInput}"
                                                    MinHeight="22" Padding="8,2" FontSize="10" />
                                    </StackPanel>
                                    <markdown:HighlightableTextBlock Classes="plainText searchToolInput" Text="{Binding InputDisplayText, Mode=OneWay}"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                                     FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}"
                                                                     FontSize="{DynamicResource ConversationCodeFontSize}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasResult}" Margin="0,4,0,0">
                                      <TextBlock Classes="detailLabel" Text="Result" Foreground="{DynamicResource TextGreenAccentBrush}"
                                                 VerticalAlignment="Center" />
                                      <ToggleButton Grid.Column="2" Classes="headerToggle" Content="{Binding ResultToggleLabel}"
                                                    IsChecked="{Binding ShowFullResult}" IsVisible="{Binding HasTruncatedResult}"
                                                    MinHeight="22" Padding="8,2" FontSize="10" />
                                    </Grid>
                                    <markdown:HighlightableTextBlock Classes="plainText searchToolResult" Text="{Binding ResultDisplayText, Mode=OneWay}"
                                                                     IsVisible="{Binding HasResult}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                     FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}"
                                                                     FontSize="{DynamicResource ConversationCodeFontSize}" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                            </Border>
                          </DataTemplate>

                          <DataTemplate DataType="vm:QuestionItemViewModel" x:DataType="vm:QuestionItemViewModel">
                            <Border Background="#18142A" BorderBrush="#4A3E76" BorderThickness="1" CornerRadius="8" Padding="12,10">
                              <StackPanel Spacing="8">
                                <TextBlock Text="Question" Foreground="{DynamicResource TextPurpleBrush}" FontSize="12" FontWeight="SemiBold" />
                                <markdown:MarkdownDocumentBlock Classes="conversationMarkdown searchQuestion" Markdown="{Binding Question.Question}"
                                                                ContentForeground="{DynamicResource TextPrimaryBrush}"
                                                                ContentFontFamily="{DynamicResource ConversationFontFamily}"
                                                                ContentFontSize="{DynamicResource ConversationFontSize}"
                                                                ContentLineHeight="{DynamicResource ConversationLineHeight}"
                                                                CodeFontSize="{DynamicResource ConversationCodeFontSize}"
                                                                TextIntensity="{DynamicResource ConversationTextIntensity}" />
                                <Border Background="#231C3D" CornerRadius="6" Padding="10,6">
                                  <markdown:HighlightableTextBlock Classes="plainText searchAnswer" Text="{Binding AnswerText, Mode=OneWay}"
                                                                   Foreground="{DynamicResource TextStrongBrush}" />
                                </Border>
                              </StackPanel>
                            </Border>
                          </DataTemplate>

                          <DataTemplate DataType="vm:UserMessageItemViewModel" x:DataType="vm:UserMessageItemViewModel">
                            <Border BorderBrush="{DynamicResource TextYellowBrush}" BorderThickness="3,0,0,0" Padding="12,2,0,2">
                              <StackPanel Spacing="6">
                                <TextBlock Text="USER (sent during the turn):" Foreground="{DynamicResource TextYellowBrush}" FontSize="15"
                                           FontWeight="SemiBold" />
                                <markdown:HighlightableTextBlock Classes="plainText searchText" Text="{Binding Text, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 FontFamily="{DynamicResource ConversationFontFamily}"
                                                                 FontSize="{DynamicResource ConversationFontSize}"
                                                                 LineHeight="{DynamicResource ConversationLineHeight}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.DataTemplates>
                      </ItemsControl>

                      <TextBlock Text="Working…" IsVisible="{Binding IsRunning}" Foreground="{DynamicResource TextCyanBrush}"
                                 FontSize="12" />
                      <SelectableTextBlock Text="{Binding Outcome}" IsVisible="{Binding HasOutcome}"
                                           Foreground="{DynamicResource TextDangerBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- The composer card, laid out like the Workbench's. It has no margin of its own, so its bottom edge lines up with
         the sidebar's. -->
    <Border Grid.Row="3" Background="#1B1F2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <ItemsControl ItemsSource="{Binding QueuedMessages}" IsVisible="{Binding HasQueuedMessages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="cli:ClaudeCliUserMessage">
              <Border Background="#182235" BorderBrush="#2D3A52" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="Queued: sent to Claude when it can accept input during this turn.">
                  <Run Text="Queued: " Foreground="{DynamicResource TextSubtleBrush}" />
                  <Run Text="{Binding Text}" />
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1" IsVisible="{Binding HasAttachments}" Background="#111722" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <!-- The scrollbar overlays the content, so leave room for it below the thumbnails. -->
            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,14">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                  <Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ComposerImageTemplate}" />
                    <Button Classes="removeImage" Command="{ReflectionBinding $parent[UserControl].DataContext.RemoveAttachmentCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="Remove image">
                      <Path />
                    </Button>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,80,80,80,Auto" ColumnSpacing="10" RowSpacing="4">
          <Grid Grid.RowSpan="2" RowDefinitions="Auto,*,Auto" RowSpacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <ProgressBar Height="6" MinHeight="0" IsVisible="{Binding IsRunning}" IsIndeterminate="{Binding IsRunning}"
                           Foreground="{DynamicResource TextCyanBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" MinWidth="42" FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}"
                         FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextCyanBrush}" TextAlignment="Right"
                         VerticalAlignment="Center" ToolTip.Tip="Elapsed time of the latest turn" />
            </Grid>
            <TextBox x:Name="Composer" Grid.Row="1" Text="{Binding ComposerText}" CaretIndex="{Binding ComposerCaretIndex, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="{DynamicResource ConversationFontSize}"
                     MinHeight="80" MaxHeight="450" PlaceholderText="Message (Ctrl+Enter or ⌘+Enter to send; paste images)" />
            <TextBlock Grid.Row="2" Text="{Binding Dictation.StatusLabel}" IsVisible="{Binding Dictation.IsStatusVisible}"
                       Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" />
          </Grid>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Button Classes="composerButton" Content="{Binding Dictation.VoiceButtonLabel}" Command="{Binding Dictation.ToggleRecordingCommand}"
                    ToolTip.Tip="{Binding Dictation.VoiceToolTip}" ToolTip.ShowOnDisabled="True" />
            <Border Background="#151A22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" MinHeight="38"
                    Padding="8,4" ToolTip.Tip="Transcription confidence">
              <TextBlock Text="{Binding Dictation.ConfidenceLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                         FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
            <Button Classes="composerButton undo" Content="{Binding Dictation.UndoButtonLabel}" Command="{Binding Dictation.UndoCommand}"
                    ToolTip.Tip="Remove the last inserted dictation transcript" />
            <Button Classes="composerButton" Content="Clear" Command="{Binding ClearComposerCommand}"
                    ToolTip.Tip="Clear the message input text" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
            <Button Classes="composerButton stop" Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop the running turn" />
            <Button Classes="composerButton image" Content="📷 Image" Click="AttachImage_Click"
                    ToolTip.Tip="{Binding ImageButtonToolTip}" />
          </StackPanel>

          <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="secondaryActionButton replayImages"
                  Classes.replaying="{Binding HasImagesBeingReplayed}" Content="{Binding ReplayImagesLabel}"
                  Command="{Binding OpenReplayImagesCommand}" HorizontalAlignment="Stretch" MinHeight="28" FontSize="12"
                  FontWeight="Medium" Padding="8,4" ToolTip.ShowOnDisabled="True"
                  ToolTip.Tip="Browse the conversation's images, choose which stay in the replay when their turn is compressed, and jump to their turns" />

          <Button Grid.Column="4" Grid.RowSpan="2" Classes="primaryActionButton dictationLocked" Command="{Binding SendCommand}" MinWidth="80"
                  VerticalAlignment="Stretch" ToolTip.Tip="While a turn runs, messages are queued and delivered to Claude during it">
            <TextBlock Text="{Binding SendLabel}" TextAlignment="Center" TextWrapping="Wrap" />
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
