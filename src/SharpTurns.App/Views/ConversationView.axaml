<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpTurns.App.ViewModels"
             x:Class="SharpTurns.App.Views.ConversationView"
             x:DataType="vm:ConversationViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="16,10">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextStrongBrush}" FontSize="16" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Project.WorkingDirectory}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                   TextTrimming="PathSegmentEllipsis" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="TurnsScroller" Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Turns}" Margin="20,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TurnViewModel">
            <StackPanel Spacing="10" Margin="0,0,0,24">
              <Border Background="{StaticResource UserCardBackgroundBrush}" BorderBrush="#2D3A52" BorderThickness="1"
                      CornerRadius="10" Padding="12,8" HorizontalAlignment="Right" MaxWidth="760">
                <SelectableTextBlock Text="{Binding UserText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap" />
              </Border>
              <SelectableTextBlock Text="{Binding AssistantText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="21"
                                   IsVisible="{Binding AssistantText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="Working…" IsVisible="{Binding IsRunning}" Foreground="{DynamicResource TextCyanBrush}"
                         FontSize="12" />
              <SelectableTextBlock Text="{Binding Outcome}" IsVisible="{Binding HasOutcome}"
                                   Foreground="{DynamicResource TextDangerBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,10">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBox x:Name="Composer" Text="{Binding ComposerText}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="72" MaxHeight="260" PlaceholderText="Message (Ctrl+Enter or ⌘+Enter to send)" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
          <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}" MinWidth="140"
                    ToolTip.Tip="Model for this conversation" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding SelectedEffort}" MinWidth="140"
                    ToolTip.Tip="Effort for this conversation" />
          <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0" />
          <Button Grid.Column="3" Classes="dangerActionButton" Content="Stop" Command="{Binding StopCommand}"
                  IsVisible="{Binding IsRunning}" />
          <Button Grid.Column="4" Classes="primaryActionButton" Content="Send" Command="{Binding SendCommand}" MinWidth="80" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
