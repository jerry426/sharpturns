<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpTurns.App.ViewModels"
        x:Class="SharpTurns.App.Views.ProjectDialog"
        x:DataType="vm:ProjectDialogViewModel"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource CardBackgroundBrush}">
  <StackPanel Margin="18" Spacing="14">
    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />

    <StackPanel Spacing="6">
      <TextBlock Text="Name" Foreground="{DynamicResource TextStrongBrush}" FontSize="13" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" PlaceholderText="Required" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Project border color" Foreground="{DynamicResource TextStrongBrush}" FontSize="13" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ColorPicker Color="{Binding SelectedColor}" IsAlphaEnabled="False" IsAlphaVisible="False"
                     ToolTip.Tip="Choose the border color for this project's cards" />
        <TextBlock Text="{Binding ColorHex}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <Button Classes="secondaryActionButton" Content="Default green" Command="{Binding ResetColorCommand}" />
      </StackPanel>
      <TextBlock Text="Used for the project's cards and the conversations sidebar."
                 Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Working directory" Foreground="{DynamicResource TextStrongBrush}" FontSize="13" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding WorkingDirectory}" PlaceholderText="Required" />
        <Button Grid.Column="1" Classes="secondaryActionButton" Content="Browse…" Click="Browse_Click" />
      </Grid>
      <TextBlock Text="{Binding DirectoryError}" IsVisible="{Binding DirectoryError, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="{DynamicResource TextDangerBrush}" FontSize="11" />
      <TextBlock Text="The CLI runs every turn in this folder and reads its CLAUDE.md."
                 Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="secondaryActionButton" Content="Cancel" Click="Cancel_Click" MinWidth="90" />
      <Button Classes="primaryActionButton" Content="Save" Click="Save_Click" IsEnabled="{Binding CanSave}" MinWidth="90"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
