<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:SharpTurns.Core"
             xmlns:views="using:SharpTurns.App.Views"
             xmlns:vm="using:SharpTurns.App.ViewModels"
             x:Class="SharpTurns.App.Views.ConversationsTabView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ConversationViewModel">
      <views:ConversationView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
    <Button Classes="secondaryActionButton" Content="›" Command="{Binding ToggleConversationSidebarCommand}"
            IsVisible="{Binding IsConversationSidebarClosed}" Width="44" Height="48" Padding="0" FontSize="28"
            VerticalAlignment="Top" ToolTip.Tip="Show the conversations sidebar" />

    <!-- The sidebar card and every conversation card use the selected project's border color. -->
    <Border Width="450" IsVisible="{Binding IsConversationSidebarOpen}" Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{Binding ProjectBorderColor}" BorderThickness="1" CornerRadius="12" Padding="12">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Text="Project:" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Classes="dictationLocked" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                    IsEnabled="{Binding !IsDictationBusy}"
                    BorderBrush="{Binding ProjectBorderColor}" MinHeight="40" FontSize="14" FontWeight="SemiBold"
                    HorizontalAlignment="Stretch" ToolTip.Tip="The project whose conversations are listed">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:Project">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Classes="secondaryActionButton" Content="‹" Command="{Binding ToggleConversationSidebarCommand}"
                  MinWidth="40" MinHeight="40" Padding="0" FontSize="24" ToolTip.Tip="Hide the conversations sidebar" />
        </Grid>

        <Button Grid.Row="1" Classes="primaryActionButton dictationLocked" Content="+ New Conversation" Command="{Binding NewConversationCommand}"
                HorizontalAlignment="Right" ToolTip.Tip="Create a conversation in this project" />

        <Border Grid.Row="2" Classes="card" BorderBrush="{Binding ProjectBorderColor}" CornerRadius="12" Padding="12"
                IsVisible="{Binding CurrentConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding CurrentConversation.Title}" Foreground="#FFD54A" FontWeight="SemiBold" FontSize="16"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondaryActionButton" Command="{Binding RenameConversationCommand}"
                      Width="34" Height="34" Padding="0" ToolTip.Tip="Rename this conversation">
                <PathIcon Width="16" Height="16" Data="{StaticResource EditIconGeometry}" />
              </Button>
              <Button Grid.Column="2" Classes="dangerActionButton dictationLocked" Command="{Binding DeleteConversationCommand}"
                      Width="34" Height="34" Padding="0" ToolTip.Tip="Delete this conversation">
                <PathIcon Width="16" Height="16" Data="{StaticResource DeleteIconGeometry}" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
              <TextBlock Classes="cardLabel" Text="ID:" />
              <TextBlock Grid.Column="1" Classes="cardValue" Text="{Binding CurrentConversation.Conversation.Id}" />
              <TextBlock Grid.Row="1" Classes="cardLabel" Text="Turns:" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="cardValue" Text="{Binding CurrentConversation.TurnCount}" />
              <TextBlock Grid.Row="2" Classes="cardLabel" Text="Last Turn:"
                         IsVisible="{Binding CurrentConversation.LastTurn, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="cardValue" Text="{Binding CurrentConversation.LastTurn.TimeLabel}"
                         IsVisible="{Binding CurrentConversation.LastTurn, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Grid.Row="3" Classes="cardLabel" Text="Workspace:" />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="cardValue" Text="{Binding SelectedProject.WorkingDirectory}" />
              <TextBlock Grid.Row="4" Classes="cardLabel" Text="Model:" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding CurrentConversation.ModelOptions}"
                        SelectedItem="{Binding CurrentConversation.SelectedModel}" MinHeight="28" FontSize="11"
                        HorizontalAlignment="Stretch" ToolTip.Tip="Model for this conversation" />
              <TextBlock Grid.Row="5" Classes="cardLabel" Text="Effort:" VerticalAlignment="Center" />
              <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding CurrentConversation.EffortOptions}"
                        SelectedItem="{Binding CurrentConversation.SelectedEffort}" MinHeight="28" FontSize="11"
                        HorizontalAlignment="Stretch" ToolTip.Tip="Effort for this conversation" />
              <TextBlock Grid.Row="6" Classes="cardLabel" Text="Output style:" VerticalAlignment="Center" />
              <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding CurrentConversation.OutputStyleOptions}"
                        SelectedItem="{Binding CurrentConversation.SelectedOutputStyle}" MinHeight="28" FontSize="11"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="The CLI's output style for this conversation. A change starts a new CLI session from the conversation history on the next turn." />
              <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10"
                          ToolTip.Tip="Compresses each turn that completes, using the summarizer model in a separate one-shot CLI call, before the next turn can be sent. The full turn stays saved. A compressed turn starts a new CLI session on the next turn, from the user inputs and Work Summaries rather than the tool activity.">
                <TextBlock Classes="settingLabel" Classes.on="{Binding CurrentConversation.AutoSummarize}" Text="Auto-Summarize"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding CurrentConversation.AutoSummarize}" OnContent="" OffContent=""
                              VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3" ToolTip.Tip="{Binding PlanUsageToolTip}"
                Background="#10230B" BorderBrush="#46536C" BorderThickness="1" CornerRadius="4">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <Border Grid.ColumnSpan="2" Padding="6,3">
              <TextBlock Text="Subscription Limits Remaining" Foreground="{DynamicResource TextCyanBrush}" FontSize="11"
                         HorizontalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsWaitingForPlanUsage}"
                       Text="waiting for usage from Claude" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                       Margin="6,3" HorizontalAlignment="Center" />
            <Border Grid.Row="1" IsVisible="{Binding HasPlanUsage}" BorderBrush="#46536C" BorderThickness="0,1,1,0" Padding="6,3">
              <TextBlock Text="5-hour" Foreground="{DynamicResource TextCyanBrush}" FontSize="11" />
            </Border>
            <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasPlanUsage}" BorderBrush="#46536C" BorderThickness="0,1,0,0" Padding="6,3">
              <TextBlock Text="{Binding FiveHourLimitLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>
            <Border Grid.Row="2" IsVisible="{Binding HasPlanUsage}" BorderBrush="#46536C" BorderThickness="0,1,1,0" Padding="6,3">
              <TextBlock Text="Weekly" Foreground="{DynamicResource TextCyanBrush}" FontSize="11" />
            </Border>
            <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding HasPlanUsage}" BorderBrush="#46536C" BorderThickness="0,1,0,0" Padding="6,3">
              <TextBlock Text="{Binding WeeklyLimitLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="4">
          <TextBlock Text="Finish dictating before switching conversations, projects, or tabs." IsVisible="{Binding IsDictationBusy}"
                     Foreground="{DynamicResource TextYellowBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OtherConversationsLabel}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                     IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled">
          <!-- Reserve the scrollbar gap during measurement; ScrollViewer padding is only applied during arrangement. -->
          <ItemsControl ItemsSource="{Binding OtherConversations}" Margin="0,0,8,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:Conversation">
                <Button Classes="cardButton dictationLocked" Margin="0,0,0,10" ToolTip.Tip="{Binding Title}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SelectConversationCommand}"
                        CommandParameter="{Binding}">
                  <Border Classes="card"
                          BorderBrush="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ProjectBorderColor}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextStrongBrush}" FontWeight="SemiBold"
                                 FontSize="15" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Id, StringFormat='ID {0} · '}" />
                        <Run Text="{Binding UpdatedAt.LocalDateTime, StringFormat='{}{0:MMM d, h:mm tt}'}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentConversation}" />
    <TextBlock Grid.Column="1" IsVisible="{Binding HasNoConversation}" Text="{Binding NoConversationText}"
               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</UserControl>
