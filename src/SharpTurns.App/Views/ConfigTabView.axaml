<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpTurns.App.ViewModels"
             xmlns:fonts="using:SharpTurns.Markdown.Rendering.Styling"
             x:Class="SharpTurns.App.Views.ConfigTabView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Border.preferenceSection">
      <Setter Property="Background" Value="#151A22" />
      <Setter Property="BorderBrush" Value="#3A3F46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.preferenceInset">
      <Setter Property="Background" Value="#101824" />
      <Setter Property="BorderBrush" Value="#2D3548" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBlock.sectionText">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.dimension">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.preferenceButton">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.modelList">
      <Setter Property="Background" Value="#101824" />
      <Setter Property="BorderBrush" Value="#2D3548" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.modelList ListBoxItem">
      <Setter Property="FontFamily" Value="{x:Static fonts:MarkdownFontFamilies.Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.serverList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.serverList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.serverList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.serverCard">
      <Setter Property="Background" Value="#10232B" />
      <Setter Property="BorderBrush" Value="#008AD8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ListBox.serverList ListBoxItem:selected Border.serverCard">
      <Setter Property="BorderBrush" Value="#20E6FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.editorLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.editorHelp">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A list's status line, framed in the tab accent so a refusal or result isn't missed. -->
    <Style Selector="Border.statusBanner">
      <Setter Property="Background" Value="#2A2410" />
      <Setter Property="BorderBrush" Value="{DynamicResource ProminentTabAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.statusBanner TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The green Add Server button. -->
    <Style Selector="Button.primaryActionButton.addServer">
      <Setter Property="Background" Value="#2A6B3F" />
      <Setter Property="BorderBrush" Value="#3E8A55" />
    </Style>
    <Style Selector="Button.primaryActionButton.addServer:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#358552" />
      <Setter Property="BorderBrush" Value="#4FA56A" />
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="12" Padding="16">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <StackPanel>
        <TextBlock Text="Config" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="18" />
        <TextBlock Text="Configure models, MCP servers, sounds, preferences, and API keys. Settings are saved in SharpTurns' local database."
                   Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="2,*">
        <Border Background="{StaticResource ProminentTabAccentBrush}" />

        <TabControl Grid.Row="1" Classes="mainTabs" SelectedIndex="3">
          <TabItem Header="Models" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="preferenceSection" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                  <TextBlock Classes="sectionTitle" Text="Models" />
                  <TextBlock Grid.Row="1" Classes="sectionText"
                             Text="The model IDs the model pickers offer, in this order. Renaming or deleting an ID moves the conversations and settings that use it." />

                  <Grid Grid.Row="2" ColumnDefinitions="420,*" ColumnSpacing="18">
                    <ListBox Classes="modelList" ItemsSource="{Binding Preferences.Models.Models}"
                             SelectedItem="{Binding Preferences.Models.SelectedModel, Mode=TwoWay}" MinHeight="320" />

                    <StackPanel Grid.Column="1" Spacing="10">
                      <TextBlock Classes="fieldLabel" Text="Model ID" />
                      <TextBox Text="{Binding Preferences.Models.ModelIdText}" PlaceholderText="claude-sonnet-5-5" MinHeight="30" MaxWidth="520"
                               HorizontalAlignment="Left" Width="520"
                               FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="13" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primaryActionButton preferenceButton" Content="Add"
                                Command="{Binding Preferences.Models.AddModelCommand}" ToolTip.Tip="Add the ID to the end of the list" />
                        <Button Classes="secondaryActionButton preferenceButton" Content="Rename"
                                Command="{Binding Preferences.Models.RenameModelCommand}"
                                ToolTip.Tip="Change the selected ID to the one in the box, everywhere it's used" />
                        <Button Classes="dangerActionButton preferenceButton" Content="Delete"
                                Command="{Binding Preferences.Models.DeleteModelCommand}"
                                ToolTip.Tip="Delete the selected ID; if it's in use, you choose the model that replaces it" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondaryActionButton preferenceButton" Content="Move Up"
                                Command="{Binding Preferences.Models.MoveModelUpCommand}" />
                        <Button Classes="secondaryActionButton preferenceButton" Content="Move Down"
                                Command="{Binding Preferences.Models.MoveModelDownCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <TextBlock Grid.Row="3" Classes="fieldLabel" Text="{Binding Preferences.Models.Message}" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </ScrollViewer>
          </TabItem>

          <!-- The server list and editor, without Test Connection, since turns don't use the servers until v2. -->
          <TabItem Header="MCP Servers" FontSize="13">
            <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,0,12,0">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="sectionTitle" Text="{Binding Preferences.McpServers.HeaderLabel}" />
                  <TextBlock Text="Configure Model Context Protocol servers (stdio). Saved in SharpTurns' local database. Turns don't use them yet: passing them to the CLI arrives in v2, and until then turns can't call MCP tools."
                             Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primaryActionButton addServer preferenceButton" Content="Add Server"
                        Command="{Binding Preferences.McpServers.AddServerCommand}" VerticalAlignment="Top" />
                <Button Grid.Column="2" Classes="secondaryActionButton preferenceButton" Content="Reload"
                        Command="{Binding Preferences.McpServers.LoadCommand}" VerticalAlignment="Top"
                        ToolTip.Tip="Bring back the saved servers" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="390,*" ColumnSpacing="16">
                <Border Background="#171A22" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="12" Padding="12">
                  <Grid RowDefinitions="*,Auto" RowSpacing="10">
                    <TextBlock Text="No MCP servers configured. Click Add Server to define one." Classes="sectionText"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding !Preferences.McpServers.HasServers}" />
                    <ListBox Classes="serverList" ItemsSource="{Binding Preferences.McpServers.Servers}"
                             SelectedItem="{Binding Preferences.McpServers.SelectedServer, Mode=TwoWay}"
                             IsVisible="{Binding Preferences.McpServers.HasServers}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:McpServerRowViewModel">
                          <Border Classes="serverCard">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextStrongBrush}" FontWeight="SemiBold"
                                           FontSize="13" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Background="#253047" BorderBrush="#4D608B" BorderThickness="1" CornerRadius="4"
                                        Padding="6,2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding StatusLabel}" Foreground="#A8C7FA" FontSize="10" />
                                </Border>
                              </Grid>
                              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                                         FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding HasDescription}" />
                              <TextBlock Text="{Binding UpdatedLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="1" Classes="statusBanner"
                            IsVisible="{Binding Preferences.McpServers.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Preferences.McpServers.Status}" />
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Background="#121620" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="10" Padding="16">
                  <Panel>
                    <TextBlock Text="Select a server to edit it, or click Add Server to create one." Classes="sectionText"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               IsVisible="{Binding Preferences.McpServers.Editor, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ScrollViewer IsVisible="{Binding Preferences.McpServers.Editor, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="12" Margin="0,0,12,0">
                        <StackPanel Spacing="12" DataContext="{Binding Preferences.McpServers.Editor}" x:DataType="vm:McpServerEditViewModel">
                          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"
                                     TextTrimming="CharacterEllipsis" />

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Name (Slug) *" />
                            <TextBox Text="{Binding Name}" PlaceholderText="e.g., chrome-devtools" IsReadOnly="{Binding IsExisting}"
                                     FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" MinHeight="30" />
                            <TextBlock Classes="editorHelp" Text="Unique identifier (no spaces). Can't be changed after creation." />
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Display Name *" />
                            <TextBox Text="{Binding DisplayName}" PlaceholderText="e.g., Chrome DevTools" FontSize="12" MinHeight="30" />
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Description" />
                            <TextBox Text="{Binding Description}" PlaceholderText="What does this server do?" FontSize="12" MinHeight="30" />
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Command (JSON Array) *" />
                            <TextBox Text="{Binding CommandJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                     FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" />
                            <TextBlock Classes="editorHelp"
                                       Text='Command to start the server in stdio mode, e.g. ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"].' />
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Environment Variables (JSON Object)" />
                            <TextBox Text="{Binding EnvJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                     FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" />
                            <TextBlock Classes="editorHelp" Text='Optional, e.g. {"NODE_ENV": "production"}. Stored in plain text, like the rest of the database.' />
                          </StackPanel>

                          <StackPanel Spacing="4">
                            <TextBlock Classes="editorLabel" Text="Working Directory" />
                            <TextBox Text="{Binding WorkingDirectory}" PlaceholderText="Optional absolute path" FontSize="12" MinHeight="30" />
                          </StackPanel>

                          <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <Button Classes="dangerActionButton preferenceButton" Content="Delete"
                                  Command="{Binding Preferences.McpServers.DeleteCommand}"
                                  IsVisible="{Binding Preferences.McpServers.Editor.IsExisting, FallbackValue=False}" />
                          <Button Classes="secondaryActionButton preferenceButton" Content="Cancel"
                                  Command="{Binding Preferences.McpServers.CancelCommand}" />
                          <Button Classes="primaryActionButton preferenceButton" Content="Save"
                                  Command="{Binding Preferences.McpServers.SaveCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </Panel>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="Sounds" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Border Background="#121620" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="sectionTitle" Text="Notification Sounds" />
                    <TextBlock Text="Configure best-effort platform system sounds for SharpTurns events. Saved in SharpTurns' local database."
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>

                  <Border Grid.Row="1" Background="#101824" BorderBrush="#315B7A" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid ColumnDefinitions="*,220,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                      <StackPanel Spacing="3">
                        <CheckBox Content="Play when a conversation turn finishes"
                                  IsChecked="{Binding Preferences.Sounds.ConversationTurnFinishedSoundEnabled}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Preferences.Sounds.ConversationTurnFinishedSoundDefaultLabel}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="26,0,0,0" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Preferences.Sounds.SystemSoundOptions}"
                                SelectedItem="{Binding Preferences.Sounds.ConversationTurnFinishedSound}" MinHeight="30" />
                      <Button Grid.Column="2" Classes="secondaryActionButton preferenceButton" Content="Preview"
                              Command="{Binding Preferences.Sounds.PreviewConversationTurnFinishedCommand}" />

                      <StackPanel Grid.Row="1" Spacing="3">
                        <CheckBox Content="Play when a permission or question dialog is displayed"
                                  IsChecked="{Binding Preferences.Sounds.CommandApprovalSoundEnabled}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Preferences.Sounds.CommandApprovalSoundDefaultLabel}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="26,0,0,0" />
                      </StackPanel>
                      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Preferences.Sounds.SystemSoundOptions}"
                                SelectedItem="{Binding Preferences.Sounds.CommandApprovalSound}" MinHeight="30" />
                      <Button Grid.Row="1" Grid.Column="2" Classes="secondaryActionButton preferenceButton" Content="Preview"
                              Command="{Binding Preferences.Sounds.PreviewCommandApprovalCommand}" />
                    </Grid>
                  </Border>

                  <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Classes="secondaryActionButton preferenceButton" Content="Reload"
                            Command="{Binding Preferences.Sounds.ReloadCommand}" ToolTip.Tip="Bring back the saved sounds" />
                    <Button Grid.Column="1" Classes="secondaryActionButton preferenceButton" Content="Save Sounds"
                            Command="{Binding Preferences.Sounds.SaveCommand}" />
                    <TextBlock Grid.Column="2" Text="{Binding Preferences.Sounds.Status}" Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>

                  <TextBlock Grid.Row="3" Text="{Binding Preferences.Sounds.PlaybackDescription}" Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="12" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Preferences" FontSize="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="22" Margin="0,0,12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                  <TextBlock Text="Application Preferences" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                             FontSize="20" />
                  <TextBlock Grid.Column="1" Text="{Binding Preferences.Status}" Foreground="{DynamicResource TextSubtleBrush}"
                             FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>

                <Border Classes="preferenceSection">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                    <TextBlock Classes="sectionTitle" Text="Claude CLI" />
                    <TextBlock Grid.Row="1" Classes="sectionText"
                               Text="The claude executable that runs turns and summaries, the model and effort new conversations start with, and the model and effort that write compressed turns' summaries." />

                    <Border Grid.Row="2" Classes="preferenceInset">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="claude path" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                          <TextBlock Classes="sectionText" FontSize="12"
                                     Text="Leave blank to run claude from your PATH. Applies to the next turn or summary." />
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding Preferences.ClaudePathText}" PlaceholderText="claude (from your PATH)"
                                 MinHeight="30" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Classes="secondaryActionButton preferenceButton" Content="Save Path"
                                  Command="{Binding Preferences.SaveClaudePathCommand}" />
                          <Button Classes="secondaryActionButton preferenceButton" Content="Reset"
                                  Command="{Binding Preferences.ResetClaudePathCommand}" ToolTip.Tip="Run claude from your PATH" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,260,Auto,180,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10"
                          RowSpacing="12">
                      <TextBlock Classes="fieldLabel" Text="New conversation model" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding Preferences.ModelOptions}"
                                SelectedItem="{Binding Preferences.NewConversationModel}" HorizontalAlignment="Stretch" MinHeight="30"
                                ToolTip.Tip="The model new conversations start with; each conversation's own picker changes it" />
                      <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Effort" Margin="10,0,0,0" />
                      <ComboBox Grid.Column="3" ItemsSource="{Binding Preferences.EffortOptions}"
                                SelectedItem="{Binding Preferences.NewConversationEffort}" HorizontalAlignment="Stretch" MinHeight="30"
                                ToolTip.Tip="The effort new conversations start with; each conversation's own picker changes it" />
                      <TextBlock Grid.Row="1" Classes="fieldLabel" Text="Summarizer model" />
                      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Preferences.ModelOptions}"
                                SelectedItem="{Binding Preferences.SummarizerModel}" HorizontalAlignment="Stretch" MinHeight="30"
                                ToolTip.Tip="Writes the Work Summary when a turn is compressed or auto-summarized" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Classes="fieldLabel" Text="Effort" Margin="10,0,0,0" />
                      <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Preferences.EffortOptions}"
                                SelectedItem="{Binding Preferences.SummarizerEffort}" HorizontalAlignment="Stretch" MinHeight="30"
                                ToolTip.Tip="The effort the summarizer model uses when it writes a Work Summary" />
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Classes="fieldLabel" Text="{Binding Preferences.ClaudeCliMessage}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Classes="preferenceSection">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <TextBlock Classes="sectionTitle" Text="Startup Behavior" />

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Restore last project and conversation on startup" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Preferences.RestoreLastSessionDescription}" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding Preferences.RestoreLastSession}" VerticalAlignment="Center"
                                    ToolTip.Tip="Saved as soon as it changes" />
                    </Grid>

                    <Border Grid.Row="2" Classes="preferenceInset">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Startup window size" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                          <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="Override the built-in" />
                            <Run Text="{Binding Preferences.StartupWindow.Default.Label}" />
                            <Run Text="startup size. Applies the next time SharpTurns starts." />
                          </TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,120,Auto,120" ColumnSpacing="8" VerticalAlignment="Center">
                          <TextBlock Classes="fieldLabel" Text="Width" />
                          <TextBox Grid.Column="1" Classes="dimension" Text="{Binding Preferences.StartupWindow.WidthText}"
                                   PlaceholderText="{Binding Preferences.StartupWindow.DefaultWidthText}" />
                          <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Height" />
                          <TextBox Grid.Column="3" Classes="dimension" Text="{Binding Preferences.StartupWindow.HeightText}"
                                   PlaceholderText="{Binding Preferences.StartupWindow.DefaultHeightText}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Classes="secondaryActionButton preferenceButton" Content="Save Window Size"
                                  Command="{Binding Preferences.StartupWindow.SaveCommand}" />
                          <Button Classes="secondaryActionButton preferenceButton" Content="Reset"
                                  Command="{Binding Preferences.StartupWindow.ResetCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="fieldLabel" Text="{Binding Preferences.StartupWindow.Message}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="preferenceSection">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <TextBlock Classes="sectionTitle" Text="Notes Dialog Defaults" />
                    <TextBlock Grid.Row="1" Classes="sectionText"
                               Text="Set the default size for the non-modal Notes window. Applies the next time a Notes window opens." />

                    <Border Grid.Row="2" Classes="preferenceInset">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,120,Auto,120" ColumnSpacing="8" VerticalAlignment="Center">
                          <TextBlock Classes="fieldLabel" Text="Width" />
                          <TextBox Grid.Column="1" Classes="dimension" Text="{Binding Preferences.NotesWindow.WidthText}"
                                   PlaceholderText="{Binding Preferences.NotesWindow.DefaultWidthText}" />
                          <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Height" />
                          <TextBox Grid.Column="3" Classes="dimension" Text="{Binding Preferences.NotesWindow.HeightText}"
                                   PlaceholderText="{Binding Preferences.NotesWindow.DefaultHeightText}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Classes="secondaryActionButton preferenceButton" Content="Save Notes Size"
                                  Command="{Binding Preferences.NotesWindow.SaveCommand}" />
                          <Button Classes="secondaryActionButton preferenceButton" Content="Reset"
                                  Command="{Binding Preferences.NotesWindow.ResetCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="fieldLabel" Text="{Binding Preferences.NotesWindow.Message}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="preferenceSection">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                    <TextBlock Classes="sectionTitle" Text="Markdown Viewer Defaults" />
                    <TextBlock Grid.Row="1" Classes="sectionText"
                               Text="Set the default size for the standalone Markdown Viewer window. Applies the next time the Markdown Viewer opens." />

                    <Border Grid.Row="2" Classes="preferenceInset">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,120,Auto,120" ColumnSpacing="8" VerticalAlignment="Center">
                          <TextBlock Classes="fieldLabel" Text="Width" />
                          <TextBox Grid.Column="1" Classes="dimension" Text="{Binding Preferences.MarkdownViewerWindow.WidthText}"
                                   PlaceholderText="{Binding Preferences.MarkdownViewerWindow.DefaultWidthText}" />
                          <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Height" />
                          <TextBox Grid.Column="3" Classes="dimension" Text="{Binding Preferences.MarkdownViewerWindow.HeightText}"
                                   PlaceholderText="{Binding Preferences.MarkdownViewerWindow.DefaultHeightText}" />
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <Button Classes="secondaryActionButton preferenceButton" Content="Save Markdown Viewer Size"
                                  Command="{Binding Preferences.MarkdownViewerWindow.SaveCommand}" />
                          <Button Classes="secondaryActionButton preferenceButton" Content="Reset"
                                  Command="{Binding Preferences.MarkdownViewerWindow.ResetCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="fieldLabel"
                                   Text="{Binding Preferences.MarkdownViewerWindow.Message}" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="preferenceSection">
                  <Grid ColumnDefinitions="*,380" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="14">
                    <TextBlock Classes="sectionTitle" Text="DOCX Export Defaults" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="sectionText"
                               Text="Configure default page layout, typography, and formatting for Word .docx exports." />
                    <TextBlock Grid.Row="2" Text="{Binding Preferences.DocxExportSettingsSummary}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Row="2" Grid.Column="1" Classes="primaryActionButton" Content="Configure DOCX Export…"
                            Command="{Binding Preferences.ConfigureDocxExportCommand}" HorizontalAlignment="Stretch" MinHeight="36" />
                  </Grid>
                </Border>

                <Border Classes="preferenceSection">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                    <TextBlock Classes="sectionTitle" Text="System Prompt" />
                    <TextBlock Grid.Row="1" Classes="sectionText"
                               Text="Appended to the CLI's own system prompt for every turn. Your CLAUDE.md and AGENTS.md files still load. A saved change starts a new CLI session from the conversation history on each conversation's next turn." />
                    <TextBox Grid.Row="2" Text="{Binding Preferences.SystemPromptText}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="320" MaxLength="20000" FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <TextBlock Classes="fieldLabel" Text="{Binding Preferences.SystemPromptMessage}" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondaryActionButton preferenceButton" Content="Reset to Default"
                                Command="{Binding Preferences.ResetSystemPromptCommand}"
                                ToolTip.Tip="Put the built-in prompt in the editor; Save applies it" />
                        <Button Classes="secondaryActionButton preferenceButton" Content="Cancel"
                                Command="{Binding Preferences.CancelSystemPromptCommand}" />
                        <Button Classes="primaryActionButton preferenceButton" Content="Save Changes"
                                Command="{Binding Preferences.SaveSystemPromptCommand}" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Only the Deepgram key, so no custom keys and no key, name, category, format, or secret fields to
               edit. -->
          <TabItem Header="API Keys" FontSize="13">
            <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,0,12,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="sectionTitle" Text="API Keys (1)" />
                  <TextBlock Text="Manage the API keys SharpTurns uses. Values are plain text in SharpTurns' local database, but masked in the UI until explicitly revealed."
                             Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondaryActionButton preferenceButton" Content="Reload"
                        Command="{Binding Preferences.ApiKeys.LoadCommand}" VerticalAlignment="Top"
                        ToolTip.Tip="Bring back the saved key" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="430,*" ColumnSpacing="16">
                <Border Background="#171A22" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="12" Padding="12">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Border Background="#10232B" BorderBrush="#008AD8" BorderThickness="1" CornerRadius="11" Padding="12">
                      <StackPanel Spacing="7">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="Deepgram API Key" Foreground="{DynamicResource TextStrongBrush}" FontWeight="SemiBold" FontSize="13" />
                          <Border Grid.Column="1" Background="#253047" BorderBrush="#4D608B" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                  VerticalAlignment="Center">
                            <TextBlock Text="Built-in" Foreground="#A8C7FA" FontSize="10" />
                          </Border>
                          <Border Grid.Column="2" Background="#21351F" BorderBrush="#3E7E38" BorderThickness="1" CornerRadius="4" Padding="6,2"
                                  VerticalAlignment="Center" IsVisible="{Binding Preferences.ApiKeys.IsConfigured}">
                            <TextBlock Text="Configured" Foreground="#B7F7B0" FontSize="10" />
                          </Border>
                        </Grid>
                        <TextBlock Text="deepgram_api_key" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" />
                        <TextBlock Text="Used by dictation transcription." Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                          <TextBlock Text="Secret" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                          <TextBlock Text="{Binding Preferences.ApiKeys.StatusLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="statusBanner"
                            IsVisible="{Binding Preferences.ApiKeys.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding Preferences.ApiKeys.Status}" />
                    </Border>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Background="#121620" BorderBrush="#2D3548" BorderThickness="1" CornerRadius="10" Padding="16">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,12,0">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Edit API Key: Deepgram API Key" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                   FontSize="16" />
                        <TextBlock Text="The settings table stores the key in plain text. Keep the database file and its backups protected."
                                   Foreground="{DynamicResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                          <TextBlock Text="Value" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                          <TextBox Text="{Binding Preferences.ApiKeys.ValueText}" PasswordChar="•"
                                   IsVisible="{Binding !Preferences.ApiKeys.RevealValue}" PlaceholderText="Paste API key" MinHeight="32"
                                   FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" />
                          <TextBox Text="{Binding Preferences.ApiKeys.ValueText}"
                                   IsVisible="{Binding Preferences.ApiKeys.RevealValue}" PlaceholderText="Paste API key" MinHeight="32"
                                   FontFamily="{x:Static fonts:MarkdownFontFamilies.Mono}" FontSize="12" />
                          <TextBlock Text="Leave blank and save to clear the stored value, or use Clear Value."
                                     Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Reveal value" IsChecked="{Binding Preferences.ApiKeys.RevealValue}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      </Grid>

                      <StackPanel Spacing="5">
                        <TextBlock Text="Description" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Used by dictation transcription: the composer's Voice button sends each recording to Deepgram."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="secondaryActionButton preferenceButton" Content="Clear Value"
                                Command="{Binding Preferences.ApiKeys.ClearValueCommand}" ToolTip.Tip="Remove the saved key" />
                        <Button Classes="secondaryActionButton preferenceButton" Content="Cancel"
                                Command="{Binding Preferences.ApiKeys.CancelCommand}" />
                        <Button Classes="primaryActionButton preferenceButton" Content="Save"
                                Command="{Binding Preferences.ApiKeys.SaveCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </Border>
</UserControl>
