<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpTurns.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpTurns.ClaudeCli\SharpTurns.ClaudeCli.csproj" />
    <ProjectReference Include="..\SharpTurns.Core\SharpTurns.Core.csproj" />
    <ProjectReference Include="..\SharpTurns.Markdown.Rendering\SharpTurns.Markdown.Rendering.csproj" />
    <ProjectReference Include="..\SharpTurns.MarkdownViewer.App\SharpTurns.MarkdownViewer.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The Markdown Viewer runs as a separate process from its own folder beside the app. -->
  <PropertyGroup>
    <MarkdownViewerOutputPath>..\SharpTurns.MarkdownViewer.App\bin\$(Configuration)\$(TargetFramework)\</MarkdownViewerOutputPath>
    <MarkdownViewerOutputPath Condition="'$(RuntimeIdentifier)' != ''">..\SharpTurns.MarkdownViewer.App\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</MarkdownViewerOutputPath>
  </PropertyGroup>

  <Target Name="CopyMarkdownViewer" AfterTargets="Build">
    <ItemGroup>
      <MarkdownViewerBuildOutput Include="$(MarkdownViewerOutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MarkdownViewerBuildOutput)"
          DestinationFiles="@(MarkdownViewerBuildOutput->'$(OutputPath)markdown-viewer\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(MarkdownViewerBuildOutput)' != ''" />
  </Target>
</Project>
